{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jonas-os-2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "keep_vars": true,
  "secrets": {
    "required": ["TELEGRAM_BOT_TOKEN"]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RADAR",
        "class_name": "RadarDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RadarDO"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}

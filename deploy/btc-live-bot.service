[Unit]
Description=BTC Live Trading Signal Radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/btc-signalbot
EnvironmentFile=/opt/btc-signalbot/.env
ExecStart=/opt/btc-signalbot/.venv/bin/python /opt/btc-signalbot/live_bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
